# Parley — copy to .env.local and fill in.
# .env.local is gitignored. Never commit real values.
# Setup walkthrough: ACCOUNTS.md

# ---- LiveKit Cloud ----------------------------------------------------
# cloud.livekit.io -> your project -> Settings -> Keys
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
# SERVER ONLY. Signs room tokens. Anyone holding this can join any room.
LIVEKIT_API_SECRET=

# ---- Supabase ---------------------------------------------------------
# supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
# Publishable / anon key. Safe in the browser bundle; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Secret / service_role key. Bypasses RLS on every table.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client ID and secret are configured in the Supabase
# dashboard (Authentication -> Providers -> Google), not here.
