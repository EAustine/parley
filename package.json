{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/contrast.mjs",
    "check:env": "node scripts/check-env.mjs",
    "predev": "npm run check:env",
    "check:rls": "node --env-file=.env.local scripts/check-rls.mjs",
    "check:codes": "node scripts/check-codes.mjs",
    "check:meetings": "node --env-file=.env.local scripts/check-meetings.mjs",
    "check:webhook": "node --env-file=.env.local scripts/check-webhook.mjs",
    "check:partition": "node scripts/check-partition.mjs",
    "seed:dev": "node --env-file=.env.local scripts/seed-dev.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:room": "node scripts/check-room.mjs",
    "fixtures:media": "node scripts/make-media-fixtures.mjs",
    "check:media": "npm run fixtures:media && node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=app --project=select-chromium --project=select-firefox --project=select-webkit && node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=media --workers=1",
    "check:engines": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=select-chromium --project=select-firefox --project=select-webkit",
    "check:chat": "node scripts/check-chat.mjs",
    "check:ics": "node scripts/check-ics.mjs",
    "dev:signin": "node --env-file=.env.local scripts/dev-signin.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:targets": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=app --project=media -g \"touch targets\"",
    "check:scrim": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=app scrim.spec.ts",
    "check:connection": "node scripts/check-connection.mjs",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@livekit/components-react": "^2.9.24",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "livekit-client": "^2.22.2",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^1.39.0",
    "nanoid": "^5.1.16",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
